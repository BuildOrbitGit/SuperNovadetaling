<meta name="google-site-verification" content="qBhEDyVs0uSnBQjJ1wyWVCNWCwot6_0fflLF9k4_a1Q" />

<script>
const packageData = [
  {
    name: "Interior Detailing",
    price: 136.88,
    duration: 150,
    description: [
      "An Express Service",
      "Good for maintenance or when your car needs a light clean",
    ],
    tags: ["Light clean", "Regular upkeep"],
    includedItems: [
      "Vacuuming",
      "Shampooing carpets and upholstery",
      "Leather conditioning",
      "Dashboard cleaning",
      "Window cleaning",
    ],
  },
  {
    name: "Interior Detailing Pro",
    price: 332.27,
    duration: 210,
    description: [
      "A Full detail of the interior and exterior",
      "Deep clean with soap and shampoo",
    ],
    tags: ["New car feel", "Seasonal detail", "My 1st detail", "Family car"],
    includedItems: [
      "Vacuuming",
      "Shampooing carpets and upholstery",
      "Leather conditioning",
      "Dashboard cleaning",
      "Window cleaning",
    ],
    highlight: "Most Popular",
  },
  {
    name: "Showroom Detailing (Interior & Exterior)",
    price: 340.88,
    duration: 240,
    description: [
      "Full restoration-level service",
      "Includes engine bay and paint correction",
    ],
    tags: ["Showroom finish", "Collector's car"],
    includedItems: [
      "Vacuuming",
      "Shampooing carpets and upholstery",
      "Leather conditioning",
      "Dashboard cleaning",
      "Window cleaning",
    ],
  },
  {
    name: "Showroom Detailing Pro (Interior & Exterior)",
    price: 340.88,
    duration: 240,
    description: [
      "Full restoration-level service",
      "Includes engine bay and paint correction",
    ],
    tags: ["Showroom finish", "Collector's car"],
    includedItems: [
      "Vacuuming",
      "Shampooing carpets and upholstery",
      "Leather conditioning",
      "Dashboard cleaning",
      "Window cleaning",
    ],
  },
  {
    name: "Exterior Detailing",
    price: 340.88,
    duration: 240,
    description: [
      "Full restoration-level service",
      "Includes engine bay and paint correction",
    ],
    tags: ["Showroom finish", "Collector's car"],
    includedItems: [
      "Vacuuming",
      "Shampooing carpets and upholstery",
      "Leather conditioning",
      "Dashboard cleaning",
      "Window cleaning",
    ],
  },
  {
    name: "Exterior Detailing Pro",
    price: 340.88,
    duration: 240,
    description: [
      "Full restoration-level service",
      "Includes engine bay and paint correction",
    ],
    tags: ["Showroom finish", "Collector's car"],
    includedItems: [
      "Vacuuming",
      "Shampooing carpets and upholstery",
      "Leather conditioning",
      "Dashboard cleaning",
      "Window cleaning",
    ],
  },
  {
    name: "New Car Package (Interior & Exterior)",
    price: 340.88,
    duration: 240,
    description: [
      "Full restoration-level service",
      "Includes engine bay and paint correction",
    ],
    tags: ["Showroom finish", "Collector's car"],
    includedItems: [
      "Vacuuming",
      "Shampooing carpets and upholstery",
      "Leather conditioning",
      "Dashboard cleaning",
      "Window cleaning",
    ],
  },
  {
    name: "New Car Package Pro (Interior & Exterior)",
    price: 340.88,
    duration: 240,
    description: [
      "Full restoration-level service",
      "Includes engine bay and paint correction",
    ],
    tags: ["Showroom finish", "Collector's car"],
    includedItems: [
      "Vacuuming",
      "Shampooing carpets and upholstery",
      "Leather conditioning",
      "Dashboard cleaning",
      "Window cleaning",
    ],
  },
];

document.addEventListener("DOMContentLoaded", () => {
  packageData.forEach((pkg) => {
    const input = document.querySelector(
      `input[type="radio"][value="${pkg.name}"]`
    );
    if (!input) return;

    const label = input.closest("label");
    if (!label) return;
    if (label.querySelector(".custom-package-details")) return;

    const container = document.createElement("div");
    container.className = "custom-package-details";
    const duration = document.createElement("p");
    duration.innerHTML = `<img src="https://www.washmenow.ca/wp-content/uploads/2025/05/HourGlassIcon.svg" alt="check icon"/> ${Math.floor(pkg.duration / 60)} hours ${
      pkg.duration % 60
    } mins`;
    container.appendChild(duration);

    const ul = document.createElement("ul");
    pkg.description.forEach((line) => {
      const li = document.createElement("li");
      li.textContent = line;
      ul.appendChild(li);
    });
    container.appendChild(ul);

    const tagWrap = document.createElement("div");
    tagWrap.innerHTML = `Perfect for: ${pkg.tags
      .map((tag) => `<span class="tag">${tag}</span>`)
      .join(" ")}`;
    container.appendChild(tagWrap);

    if (pkg.highlight) {
      const highlight = document.createElement("div");
      highlight.className = "highlight-badge";
      highlight.textContent = pkg.highlight;
      label.prepend(highlight);
    }

    if (pkg.discount) {
      const discount = document.createElement("div");
      discount.className = "discount-label";
      discount.textContent = pkg.discount;
      container.appendChild(discount);
    }
    // "What's included" button
    if (pkg.includedItems && pkg.includedItems.length) {
      const btn = document.createElement("a");
      btn.href = "#";
      btn.textContent = "what's included";
      btn.style.display = "inline-block";
      btn.style.marginTop = "10px";
      btn.style.color = "#007bff";
      btn.style.cursor = "pointer";

      btn.addEventListener("click", (e) => {
        e.preventDefault();

        const list = document.getElementById("included-list");
        list.innerHTML = ""; // clear previous

        pkg.includedItems.forEach((item) => {
          const li = document.createElement("li");
          li.textContent = item;
          list.appendChild(li);
        });

        document.getElementById("modal-overlay").style.display = "block";
        document.getElementById("included-modal").style.display = "block";
      });

      container.appendChild(btn);
    }

    const price = document.createElement("div");
    price.className = "price-tag";
    price.textContent = `$${pkg.price.toFixed(2)}`;
    label.appendChild(price);

    label.appendChild(container);
  });
});

