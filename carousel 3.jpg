	<div class="img has-hover x md-x lg-x y md-y lg-y" id="image_1466303097">
								<div class="img-inner dark" >
			<img loading="lazy" decoding="async" width="310" height="470" src="https://www.washmenow.ca/wp-content/uploads/2022/05/auto-detailing-perfection-brampton.jpg" class="attachment-original size-original" alt="auto detailing perfection brampton" srcset="https://www.washmenow.ca/wp-content/uploads/2022/05/auto-detailing-perfection-brampton.jpg 310w, https://www.washmenow.ca/wp-content/uploads/2022/05/auto-detailing-perfection-brampton-198x300.jpg 198w" sizes="auto, (max-width: 310px) 100vw, 310px" />						
					</div>
								
