<style id="custom-css" type="text/css">:root {--primary-color: #ee3130;--fs-color-primary: #ee3130;--fs-color-secondary: #21a8e1;--fs-color-success: #7a9c59;--fs-color-alert: #b20000;--fs-experimental-link-color: #334862;--fs-experimental-link-color-hover: #111;}.tooltipster-base {--tooltip-color: #fff;--tooltip-bg-color: #000;}.off-canvas-right .mfp-content, .off-canvas-left .mfp-content {--drawer-width: 300px;}.container-width, .full-width .ubermenu-nav, .container, .row{max-width: 1290px}.row.row-collapse{max-width: 1260px}.row.row-small{max-width: 1282.5px}.row.row-large{max-width: 1320px}.header-main{height: 110px}#logo img{max-height: 110px}#logo{width:230px;}.header-bottom{min-height: 40px}.header-top{min-height: 30px}.transparent .header-main{height: 90px}.transparent #logo img{max-height: 90px}.has-transparent + .page-title:first-of-type,.has-transparent + #main > .page-title,.has-transparent + #main > div > .page-title,.has-transparent + #main .page-header-wrapper:first-of-type .page-title{padding-top: 140px;}.header.show-on-scroll,.stuck .header-main{height:110px!important}.stuck #logo img{max-height: 110px!important}.header-bg-color {background-color: rgba(255,255,255,0.97)}.header-bottom {background-color: #f1f1f1}.header-main .nav > li > a{line-height: 16px }.header-wrapper:not(.stuck) .header-main .header-nav{margin-top: 9px }.stuck .header-main .nav > li > a{line-height: 50px }.header-bottom-nav > li > a{line-height: 16px }@media (max-width: 549px) {.header-main{height: 70px}#logo img{max-height: 70px}}body{color: rgba(10,10,12,0.8)}h1,h2,h3,h4,h5,h6,.heading-font{color: #0a0a0c;}body{font-size: 100%;}@media screen and (max-width: 549px){body{font-size: 100%;}}body{font-family: Poppins, sans-serif;}body {font-weight: 400;font-style: normal;}.nav > li > a {font-family: Poppins, sans-serif;}.mobile-sidebar-levels-2 .nav > li > ul > li > a {font-family: Poppins, sans-serif;}.nav > li > a,.mobile-sidebar-levels-2 .nav > li > ul > li > a {font-weight: 400;font-style: normal;}h1,h2,h3,h4,h5,h6,.heading-font, .off-canvas-center .nav-sidebar.nav-vertical > li > a{font-family: Poppins, sans-serif;}h1,h2,h3,h4,h5,h6,.heading-font,.banner h1,.banner h2 {font-weight: 700;font-style: normal;}.alt-font{font-family: "Dancing Script", sans-serif;}.alt-font {font-weight: 400!important;font-style: normal!important;}.header:not(.transparent) .header-nav-main.nav > li > a {color: #3a3d3f;}.header:not(.transparent) .header-nav-main.nav > li > a:hover,.header:not(.transparent) .header-nav-main.nav > li.active > a,.header:not(.transparent) .header-nav-main.nav > li.current > a,.header:not(.transparent) .header-nav-main.nav > li > a.active,.header:not(.transparent) .header-nav-main.nav > li > a.current{color: #ee3130;}.header-nav-main.nav-line-bottom > li > a:before,.header-nav-main.nav-line-grow > li > a:before,.header-nav-main.nav-line > li > a:before,.header-nav-main.nav-box > li > a:hover,.header-nav-main.nav-box > li.active > a,.header-nav-main.nav-pills > li > a:hover,.header-nav-main.nav-pills > li.active > a{color:#FFF!important;background-color: #ee3130;}.footer-1{background-color: #ffffff}.footer-2{background-color: #777777}.absolute-footer, html{background-color: #eeeeef}.nav-vertical-fly-out > li + li {border-top-width: 1px; border-top-style: solid;}/* Custom CSS */.wpcf7-spinner{display: none;}.row-large>.col.skew-img{padding-bottom: 0;padding-right: 0;padding-left: 0;}.skew-img{position: absolute;right: 0;top: 0;bottom: 0;}.skew-img .img{transform: skewX(155deg);transform-origin: 0 100%;}.skew-img .img, .skew-img .img-inner, .skew-img img, .skew-img .col-inner{height: 100%;}.skew-img img{transform: skewX(-155deg);transform-origin: 0 100%;object-fit: cover;object-position: 50% 50%;}.captcha-image {margin-bottom: 30px;}/* Custom CSS Tablet */@media (max-width: 849px){.skew-img{position: static;overflow: hidden;}.skew-img .img, .skew-img img{transform: none;}.header-bottom .container {padding-right: 0;padding-left: 0;}.header-bottom .nav > li.html {width: 100%;}.cta-mobile-buttons a[href*="wa.me"].success {background-color: #25d366;}.cta-mobile-buttons a[href*="wa.me"] .icon-phone::before {content: '';display: block;width: 16px;height: 16px;background: url("https://www.washmenow.ca/wp-content/uploads/2023/04/icon-whatsapp.svg") no-repeat 0 0 / contain;}}.label-new.menu-item > a:after{content:"New";}.label-hot.menu-item > a:after{content:"Hot";}.label-sale.menu-item > a:after{content:"Sale";}.label-popular.menu-item > a:after{content:"Popular";}</style><style id="wp-custom-css">
.bafg-twentytwenty-container, .bafg-twentytwenty-container img {
	max-height: 500px;
}

/* .bafg-twentytwenty-container img {
max-height: 500px !important;
height: auto !important;
max-width: auto; !important;
width: 100% !important;
} */
.card-img-f .box-image {
	max-width: 50%;
	max-height: 100%;
}
.white-captcha .captcha-image {
	color: #fff;
	width: 100%;
	margin-inline: auto;
	border: none;
	& label {
		color: #fff;
	}
}

/* custom form start */
.custom-ms-form {
	max-width: 800px;
	margin-right: auto;
	margin-left: 0;
	padding: 20px;
}
.custom-ms-form select {
	border: none;
	border-bottom: 1px solid;
	box-shadow: none;
}
.custom-ms-form .uacf7-next, .custom-ms-form .uacf7-prev {
	border-radius: 8px;
	color: #fff;
}
.custom-ms-form .uacf7-next {
	background: var(--wp--preset--color--secondary);
}

.custom-ms-form .uacf7-prev {
	background: var(--wp--preset--color--primary);
}
.wpcf7-radio.custom-form-input>span {
	width: 100%;
}
.custom-ms-form label:has(input[name="package"]) {
	position: relative;
	padding: 15px;
	border: 2px solid lightgray !important;
	border-radius: 20px;
	font-size: 120%;
	font-weight: 600;
	margin-bottom: 2rem;
	transition: all 0.2s ease;
}
.custom-ms-form label span {
	max-width: 100px !important;
	width: auto !important;
	white-space: normal !important;
	word-wrap: break-word !important;
	overflow-wrap: break-word !important;
}

.custom-ms-form label div {
	font-weight: 400;
}
.custom-ms-form label:has(input[name="package"]:checked) {
	border: 2px solid var(--wp--preset--color--secondary) !important;
}
.custom-ms-form .price-tag {
	position: absolute;
	right: 1rem;
	top: 15px;
	font-weight: 600;
}

.custom-ms-form .highlight-badge {
	position: absolute;
	top: -1rem;
	left: 50%;
	transform: translate(-50%, 0);
	background: var(--wp--preset--color--secondary);
	border-radius: 50px;
	text-align: center;
	color: #fff;
	width: fit-content;
	padding: 0.1rem 2rem 0 2rem;
}
.custom-ms-form .custom-package-details img {
	width: 23px;
	margin-left: 3px;
}
.custom-ms-form label ul li {
	padding-left: 30px;
}
.custom-ms-form label ul li::before {
	left: 5px;
	background: url("https://www.washmenow.ca/wp-content/uploads/2025/05/CheckIcon.svg") no-repeat 0 0 !important;
	width: 18px;
	height: 18px;
	background-size: cover !important;
}
@media (max-width: 600px) {

}
/* custom form end */
</style>
