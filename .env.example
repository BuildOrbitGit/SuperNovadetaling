# ── Resend (email sending) ─────────────────────────────────────────────────
# Get your key at https://resend.com → API Keys
RESEND_API_KEY=re_...

# Email the owner receives booking notifications at
OWNER_EMAIL=owner@supernovadetailing.ca

# "From" address shown to customers (must be a verified domain in Resend)
FROM_EMAIL=bookings@supernovadetailing.ca

# ── Vercel Blob (photo storage) ────────────────────────────────────────────
# Vercel Dashboard → Storage → Create Blob store → copy token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Google Calendar (auto-adds confirmed bookings) ─────────────────────────
# See README.md → "Google Calendar Setup" for step-by-step instructions
GOOGLE_CLIENT_EMAIL=supernova-cal@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
